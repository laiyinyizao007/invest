{
  "openapi": "3.0.3",
  "info": {
    "title": "invest 研究沙盒网关",
    "version": "1.0.0",
    "description": "毕昇调用确定性内核的唯一通道。只有下列端点;不存在下单、查账户、改风控、访问测试段、批准代码的能力。批准只能由人在本机执行 research_api.py approve。"
  },
  "servers": [
    {
      "url": "http://research-gateway:8765"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/research/data": {
      "get": {
        "operationId": "list_data_segments",
        "summary": "列出可用数据段(训练/验证)、测试段是否已被消费,以及迭代额度 iteration{used,limit,window_hours,next_release_in_seconds}。测试段不可经此访问。",
        "responses": {
          "200": {
            "description": "数据段清单"
          }
        }
      }
    },
    "/research/candidates": {
      "post": {
        "operationId": "submit_candidate",
        "summary": "提交候选策略源码,落入 pending 目录。提交不等于批准;需要人读代码后在本机批准才能运行。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "source"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "文件名,小写字母数字下划线,以 .py 结尾,最长 40 字符"
                  },
                  "source": {
                    "type": "string",
                    "description": "策略源码;禁止导入 os/subprocess/socket 等,禁止 exec/eval/open 等"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已提交,返回 name 与 sha256"
          },
          "400": {
            "description": "命名/大小/静态筛查未通过"
          },
          "409": {
            "description": "同名候选已存在,请换名"
          },
          "429": {
            "description": "滚动窗口内提交数已达上限(默认 24 小时最多 5 个);响应里说明已用额度与最早一条何时释放"
          },
          "500": {
            "description": "提交账本损坏或无法写入,拒绝提交(fail-closed)"
          }
        }
      }
    },
    "/research/backtest": {
      "post": {
        "operationId": "run_backtest",
        "summary": "在训练或验证段做沙盒回测(日线 CADJ/MAADJ)。仅运行已被人批准的代码;返回绩效与诊断书。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "strategy",
                  "class",
                  "key",
                  "segment"
                ],
                "properties": {
                  "strategy": {
                    "type": "string",
                    "description": "已提交的文件名"
                  },
                  "class": {
                    "type": "string",
                    "description": "策略类名"
                  },
                  "key": {
                    "type": "string",
                    "enum": [
                      "CADJ",
                      "MAADJ"
                    ]
                  },
                  "segment": {
                    "type": "string",
                    "enum": [
                      "train",
                      "valid"
                    ]
                  },
                  "params": {
                    "type": "object",
                    "description": "策略参数"
                  },
                  "view": {
                    "type": "string",
                    "enum": [
                      "report",
                      "text"
                    ],
                    "description": "report:只返回 {run_id, passed, status, report}(JSON);text:只返回纯文本中文报告(适合工作流结果节点直接展示);不填返回完整结果。出错时一律返回 JSON"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "绩效 + 四维诊断书(回撤/次数/连亏/夏普)"
          },
          "403": {
            "description": "代码尚未被人批准"
          },
          "409": {
            "description": "已有作业在运行"
          },
          "504": {
            "description": "超时"
          }
        }
      }
    },
    "/research/gate": {
      "post": {
        "operationId": "run_gate",
        "summary": "晋级门槛评估:15 分钟玉米滚动验证段上跑候选、成本翻倍、随机入场对照,按门槛逐条给出结果。只评估,不批准、不上线。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "strategy",
                  "class"
                ],
                "properties": {
                  "strategy": {
                    "type": "string"
                  },
                  "class": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  },
                  "random_runs": {
                    "type": "integer",
                    "description": "随机对照次数;缺省取服务端配置"
                  },
                  "plateau": {
                    "type": "object",
                    "description": "参数网格得分 {cell:[i,j,k], scores:[[i,j,k,score],...]};缺省则参数高原按未通过"
                  },
                  "view": {
                    "type": "string",
                    "enum": [
                      "report",
                      "text"
                    ],
                    "description": "report:只返回 {run_id, passed, status, report}(JSON);text:只返回纯文本中文报告(适合工作流结果节点直接展示);不填返回完整结果。出错时一律返回 JSON"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "passed、failures、metrics、windows、diagnosis、protocol_notice"
          },
          "403": {
            "description": "代码尚未被人批准"
          },
          "409": {
            "description": "已有作业在运行"
          },
          "504": {
            "description": "超时"
          }
        }
      }
    },
    "/research/feedback": {
      "get": {
        "operationId": "get_recent_failures",
        "summary": "最近若干次失败的结构化 Trace(条数由服务端配置限定,默认 3),**只含 product 指定品种的失败**。只含固定字段;候选自己写的报错文字不原样返回,只保留可被固定模板识别的内置报错片段。",
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "required": true,
            "description": "评估品种(C15/V15/EB15/EG15/PP15/M15);必填,不带返回 400",
            "schema": {
              "type": "string",
              "enum": ["C15", "V15", "EB15", "EG15", "PP15", "M15"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "traces 列表(仅该品种)"
          },
          "400": {
            "description": "product 缺失或不在白名单"
          }
        }
      }
    },
    "/research/results/{run_id}": {
      "get": {
        "operationId": "get_result",
        "summary": "读取一次回测或门槛评估的完整结果。评估还没跑完时返回 status=running;失败为 status=error(含原因);网关重启打断为 status=interrupted(试验次数已预扣,不退还)。",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "结果"
          },
          "404": {
            "description": "不存在"
          }
        }
      }
    },
    "/research/evaluate": {
      "post": {
        "operationId": "run_evaluate",
        "summary": "选参 + 晋级门槛评估(推荐):候选类须声明 param_grid(恰好三个策略参数,各至少 3 个递增数值,且参数名须出现在类的 parameters 列表里)。服务端先在选参窗口(止于 2022-06-30)扫网格、邻域平滑选参并判定参数高原,再用选出的参数在其后的滚动验证窗口上做完整门槛评估,两段数据不重叠。风控参数(risk_budget 等)不得进入网格。仅运行已被人批准的代码。**异步**:本接口在批准检查、静态筛查、试验预扣都通过后**立即返回** {run_id, status:running},评估在后台跑(通常几分钟);用 get_result(run_id) 取结果,status 为 running 表示还在跑,别重复提交。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "strategy",
                  "class"
                ],
                "properties": {
                  "strategy": {
                    "type": "string",
                    "description": "已提交的文件名"
                  },
                  "class": {
                    "type": "string",
                    "description": "策略类名;须继承 TrendAtr15mStrategy 并声明 param_grid"
                  },
                  "random_runs": {
                    "type": "integer",
                    "description": "随机对照次数;缺省取服务端配置"
                  },
                  "product": {
                    "type": "string",
                    "enum": ["C15", "V15", "EB15", "EG15", "PP15", "M15"],
                    "description": "评估品种(15 分钟复权主力连续):C15 玉米(缺省)、V15 PVC、EB15 苯乙烯、EG15 乙二醇、PP15 聚丙烯、M15 豆粕。必须与研究想法里的品种一致"
                  },
                  "view": {
                    "type": "string",
                    "enum": [
                      "report",
                      "text"
                    ],
                    "description": "report:只返回 {run_id, passed, status, report}(JSON);text:只返回纯文本中文报告(适合工作流结果节点直接展示);不填返回完整结果。出错时一律返回 JSON"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已启动:run_id、status=running(注意是 200 不是 202:毕昇工具层把非 200 都当异常)。最终结果见 get_result(run_id):passed、failures、params(选出的参数)、selection(选参摘要:有效格子数、是否在高原)、metrics、windows、diagnosis;候选自身出错时 status=strategy_error 及 error"
          },
          "403": {
            "description": "代码尚未被人批准"
          },
          "409": {
            "description": "已有作业在运行"
          },
          "504": {
            "description": "超时"
          }
        }
      }
    }
  }
}
