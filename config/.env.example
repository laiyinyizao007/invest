# 复制为项目根目录的 .env 后填写(.env 已被 .gitignore 忽略,切勿提交)。Docker 部署时由 docker-compose 的 env_file 注入。

# ---- CTP 账号(SimNow 的前置机地址、BrokerID、AppID/授权编码以 SimNow 官网 https://www.simnow.com.cn/product.action 当前公布为准) ----
# 2026-11 官网公布的第一套(交易时段,真实行情):BrokerID=9999;交易前置 182.254.243.31:30001;行情前置 182.254.243.31:30011;
# AppID=simnow_client_test;认证码=16 个 0。网上教程里的旧地址(180.168.146.187:101xx/102xx)已失效。
CTP_USERNAME=
CTP_PASSWORD=
CTP_BROKER_ID=
CTP_TD_ADDRESS=
CTP_MD_ADDRESS=
CTP_APP_ID=
CTP_AUTH_CODE=
# 实盘 = 生产版 API(SimNow 与实盘使用);测试 = 期货公司看穿式监管测试环境
CTP_ENVIRONMENT=实盘
# 期货公司看穿式测试环境(如国信期货):前置地址/BrokerID/AppID/AuthCode 填对方书面给的测试环境参数,CTP_ENVIRONMENT=测试;
# 通过后换成生产参数并改回 实盘。测试与生产的 AppID/AuthCode 不通用。步骤见 docs/live-readiness.md C2。

# ---- 国信测试报告(scripts/broker_test.py + scripts/broker_report.py;提交方信息只放这里,不入库) ----
# AppID 命名(国信模板 1.4):个人客户自开发系统 client_系统名称_版本号(系统名≤10 位、版本号≤8 位),如 client_invest_1.0;
# 实盘 AppID 必须与测试 AppID 一致,所以名称与版本号定了就别随意改。授权码由国信按提交的 AppID 生成。
BROKER_TEST_SYSTEM_NAME=
BROKER_TEST_VERSION=
BROKER_TEST_SUBMITTER=
BROKER_TEST_CONTACT=
BROKER_TEST_PHONE=
BROKER_TEST_EMAIL=
# 软件功能勾选(逗号分隔,取自国信模板选项);留空 = 自动开平仓,止盈止损,交易模型编写,二次开发
BROKER_TEST_FUNCTIONS=
# 国信模板 docx 的路径(模板含国信测试环境 IP/端口,不入库)
BROKER_REPORT_TEMPLATE=
# 证据图需要中文字体:默认找 C:\Windows\Fonts\msyh.ttc,找不到再指定
BROKER_REPORT_FONT=

# ---- 行情录制（官方 vnpy_datarecorder；只连行情，不发单） ----
# 默认 SimNow；国信测试必须显式使用 CTP_RECORD_PROFILE=guoxin-test 且 CTP_ENVIRONMENT=测试。
CTP_RECORD_PROFILE=simnow
# 录制入口需要 CTP_TD_ADDRESS/CTP_APP_ID/CTP_AUTH_CODE：合约信息只能从交易前置查询，且仅用于认证+查合约（发单/查账户被硬性禁止）。
# guoxin-test 必须列出允许连接的 host:port（取自期货公司书面测试环境参数，只写本机 .env）：
CTP_RECORD_ALLOWED_ADDRESSES=
# 必须填写具体合约，不使用 C0/MA0；示例：c2701.DCE,MA701.CZCE
CTP_RECORD_SYMBOLS=
CTP_RECORD_TICK=true
CTP_RECORD_1M=true
CTP_RECORD_STATE_DIR=.ops/recording
CTP_RECORD_DATABASE_DIR=.vntrader_record
# DSH Desktop 关闭期间不保证录制持续；DSH 只调度短任务 ensure/watchdog。

# ---- 交易标的 ----
# 要交易的具体合约(主力会换月,需要定期更新),如玉米 c2701.DCE
LIVE_VT_SYMBOL=
# 预热用的历史日线代码:先运行 python scripts/build_continuous.py --symbol C --save,再填 CADJ.DCE
HISTORY_VT_SYMBOL=CADJ.DCE

# ---- 通知(可选) ----
# WEBHOOK_KIND: generic | feishu | telegram;telegram 需要 WEBHOOK_TELEGRAM_CHAT_ID,URL 形如 https://api.telegram.org/bot<token>/sendMessage
WEBHOOK_URL=
WEBHOOK_KIND=generic
WEBHOOK_TELEGRAM_CHAT_ID=
# 低于该级别的消息不发送:INFO | WARN | ERROR | FATAL
WEBHOOK_MIN_LEVEL=INFO
# 落盘待补发队列:发送失败(如本机断网)的告警写入此文件,网络恢复后自动补发(带「【补发】」前缀,INFO 合并成摘要)。
# 留空 = 默认 data/state/webhook_outbox.jsonl;写 off 关闭;也可以写别的路径。
WEBHOOK_OUTBOX=
# 心跳间隔(秒),0 = 不发
HEARTBEAT_SECONDS=0

# 账户级风控阈值在 config/risk_manager_setting.json 的"账户风控"一节(当日熔断 600 元 / 累计死线 2000 元)
