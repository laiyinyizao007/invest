# CTP 账号配置(复制为项目根目录 .env 后填写,切勿提交 .env)
# SimNow 的 BrokerID、前置地址、AppID/AuthCode 以 SimNow 官网当前公布为准
CTP_USERNAME=
CTP_PASSWORD=
CTP_BROKER_ID=
CTP_TD_ADDRESS=
CTP_MD_ADDRESS=
CTP_APP_ID=
CTP_AUTH_CODE=

# Webhook 通知(可选,Telegram Bot 等)
WEBHOOK_URL=

# 策略层风控默认值
RISK_STOP_LOSS_PCT=2
RISK_REWARD_RATIO=3
RISK_MAX_CONSECUTIVE_LOSSES=3
