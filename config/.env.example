# 复制为项目根目录的 .env 后填写(.env 已被 .gitignore 忽略,切勿提交)。Docker 部署时由 docker-compose 的 env_file 注入。

# ---- CTP 账号(SimNow 的前置机地址、BrokerID、AppID/授权编码以 SimNow 官网 https://www.simnow.com.cn/product.action 当前公布为准) ----
# 2026-11 官网公布的第一套(交易时段,真实行情):BrokerID=9999;交易前置 182.254.243.31:30001;行情前置 182.254.243.31:30011;
# AppID=simnow_client_test;认证码=16 个 0。网上教程里的旧地址(180.168.146.187:101xx/102xx)已失效。
CTP_USERNAME=
CTP_PASSWORD=
CTP_BROKER_ID=
CTP_TD_ADDRESS=
CTP_MD_ADDRESS=
CTP_APP_ID=
CTP_AUTH_CODE=
# 实盘 = 生产版 API(SimNow 与实盘使用);测试 = 期货公司看穿式监管测试环境
CTP_ENVIRONMENT=实盘
# 期货公司看穿式测试环境(如国信期货):前置地址/BrokerID/AppID/AuthCode 填对方书面给的测试环境参数,CTP_ENVIRONMENT=测试;
# 通过后换成生产参数并改回 实盘。测试与生产的 AppID/AuthCode 不通用。步骤见 docs/live-readiness.md C2。

# ---- 交易标的 ----
# 要交易的具体合约(主力会换月,需要定期更新),如玉米 c2701.DCE
LIVE_VT_SYMBOL=
# 预热用的历史日线代码:先运行 python scripts/build_continuous.py --symbol C --save,再填 CADJ.DCE
HISTORY_VT_SYMBOL=CADJ.DCE

# ---- 通知(可选) ----
# WEBHOOK_KIND: generic | feishu | telegram;telegram 需要 WEBHOOK_TELEGRAM_CHAT_ID,URL 形如 https://api.telegram.org/bot<token>/sendMessage
WEBHOOK_URL=
WEBHOOK_KIND=generic
WEBHOOK_TELEGRAM_CHAT_ID=
# 低于该级别的消息不发送:INFO | WARN | ERROR | FATAL
WEBHOOK_MIN_LEVEL=INFO
# 心跳间隔(秒),0 = 不发
HEARTBEAT_SECONDS=0

# 账户级风控阈值在 config/risk_manager_setting.json 的"账户风控"一节(当日熔断 600 元 / 累计死线 2000 元)
